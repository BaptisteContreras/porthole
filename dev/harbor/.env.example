# Harbor hostname (used in redirect URLs and TLS)
HARBOR_HOSTNAME=registry.example.com

# Harbor admin UI password
HARBOR_ADMIN_PASSWORD=changeme

# PostgreSQL password for the harbor database user
HARBOR_DB_PASSWORD=changeme

# Random secret shared between core and jobservice (min 16 chars)
HARBOR_CORE_SECRET=replace_with_random_secret
HARBOR_JOBSERVICE_SECRET=replace_with_random_secret

# AES key used by core to encrypt sensitive data (must be exactly 16 chars)
HARBOR_CORE_KEY=replace_with_16chr
