{
    "name": "bapt/porthole",
    "description": "Harbor pull activity reporter CLI",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/console": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/tui": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Porthole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porthole\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/porthole"],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
